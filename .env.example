# Copy to .env (or set these in your hosting provider's dashboard).

# Port the server listens on.
PORT=3000

# PostgreSQL. Create the database and schema with: npm run db:setup
# URL-encode special characters in the password when using DATABASE_URL.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/hrms
PGSSLMODE=disable
PGPOOL_MAX=10
# Alternatively leave DATABASE_URL empty and use these fields. PGPASSWORD is raw.
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=hrms
# PGUSER=postgres
# PGPASSWORD=
# Hosted PostgreSQL: PGSSLMODE=require (valid TLS certificate required).
# PGSSLROOTCERT=optional PEM certificate, with literal \n between lines

# Uploaded files only. Back up this folder AND PostgreSQL separately.
DATA_DIR=./data

# "demo" (default) loads the fictional demo company on first start.
# "empty" starts with only an administrator account.
SEED=empty
ADMIN_EMAIL=admin@brainadz.com
ADMIN_PASSWORD=

# Claude for the Resume Screener and "Ask AI". Leave empty for rule-based scoring.
ANTHROPIC_API_KEY=
# HRMS_AI_MODEL=claude-opus-5-5

# Set both when the app is served over HTTPS behind a proxy (Render, Railway, Nginx).
TRUST_PROXY=1
COOKIE_SECURE=true
