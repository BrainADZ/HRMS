# Copy this file to .env. Keep passwords and API keys here only.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/hrms
SEED=empty
ADMIN_EMAIL=admin@example.com
# Set a strong admin password. If blank, startup prints a generated temporary one.
ADMIN_PASSWORD=

# One-time deployment command: npm run admin:create (after the app's first start).
# Use a new email; do not reuse an existing admin account.
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=

# Admin password-reset emails. Use a Google App Password, not the sign-in password.
PUBLIC_APP_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Optional local settings:
# PORT=3001
# Use a different cookie from the Downloads project when running both locally.
# SESSION_COOKIE_NAME=hrms_workspace_session
# ANTHROPIC_API_KEY=

# For HTTPS behind a trusted reverse proxy, set both:
# TRUST_PROXY=1
# COOKIE_SECURE=true

VITE_API_BASE_URL=/api
# Optional local development shortcuts; always disabled in production.
LOCAL_QUICK_LOGIN=false
