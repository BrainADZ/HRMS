# Copy to server/.env (or set these in your hosting provider's dashboard).
# Backend only: never put database passwords or API keys in client/.env.

# Port the server listens on.
PORT=3000
# Keep true for the optional combined production server; dev runs API only.
SERVE_CLIENT=true
# Optional, when the browser calls a separate API origin directly.
# CLIENT_ORIGIN=http://127.0.0.1:5173

# PostgreSQL. Create the database and schema with: npm run db:setup
# URL-encode special characters in the password when using DATABASE_URL.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/hrms
PGSSLMODE=disable
PGPOOL_MAX=10
# Alternatively leave DATABASE_URL empty and use these fields. PGPASSWORD is raw.
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=hrms
# PGUSER=postgres
# PGPASSWORD=
# Hosted PostgreSQL: PGSSLMODE=require (valid TLS certificate required).
# PGSSLROOTCERT=optional PEM certificate, with literal \n between lines

# Uploaded files only. Back up this folder AND PostgreSQL separately.
DATA_DIR=./data

# "demo" (default) loads the fictional demo company on first start.
# "empty" starts with only an administrator account.
SEED=empty
# Optional for local demonstrations. Production always hides shared demo logins
# and refuses their shared password, even when demo data already exists.
EXPOSE_DEMO_LOGINS=false
ADMIN_EMAIL=admin@brainadz.com
ADMIN_PASSWORD=

# Claude for the Resume Screener and "Ask AI". Leave empty for rule-based scoring.
ANTHROPIC_API_KEY=
# HRMS_AI_MODEL=claude-opus-5-5

# Local HTTP uses non-secure cookies. For HTTPS behind a proxy, set both:
# TRUST_PROXY=1
# COOKIE_SECURE=true
COOKIE_SECURE=false
