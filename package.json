{
  "name": "brainadz-hrms",
  "version": "1.0.0",
  "description": "BrainADZ HRMS - people operations across BrainADZ Live, Marketing and Exhibits",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node server/scripts/dev.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "test": "node --v8-pool-size=1 --wasm-num-compilation-tasks=1 --test --test-concurrency=1 \"server/tests/*.test.js\"",
    "demo": "node server/demo.js",
    "db:setup": "node --env-file-if-exists=.env server/scripts/db-setup.js",
    "db:backup": "node --env-file-if-exists=.env server/scripts/db-backup.js",
    "db:verify-backup": "node --env-file-if-exists=.env server/scripts/db-verify-backup.js",
    "test:browser": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@vitejs/plugin-react": "^4.7.0",
    "express": "^5.3.0",
    "lucide-react": "^1.55.0",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "unpdf": "^1.8.1",
    "vite": "^6.4.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1"
  },
  "overrides": {
    "argparse": "^2.0.1"
  }
}
